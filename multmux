set -euo pipefail

# multmux - tmux wrapper using two isolated sockets
# https://github.com/DenisDupeyron/multmux

VERSION="1.0.1"
CONF_FILE="${HOME}/.config/multmux.conf"
CACHE_DIR="${HOME}/.cache/multmux"
INSTALL_DIR="${HOME}/.local/bin"
REINSTALL_COMMAND="curl -fsSL https://raw.githubusercontent.com/DenisDupeyron/multmux/main/install.sh | bash"
OUTER_SOCKET="${MULTMUX_OUTER_SOCKET:-multmux-outer}"
INNER_SOCKET="${MULTMUX_INNER_SOCKET:-multmux-inner}"
TMO="tmux -L ${OUTER_SOCKET}"
TMI="tmux -L ${INNER_SOCKET}"
# Overridable for tests (see tests/), same pattern as the socket vars above.
REPO_URL="${MULTMUX_REPO_URL:-https://raw.githubusercontent.com/DenisDupeyron/multmux/main}"

# Absolute path to this script. tmux run-shell hooks do not reliably inherit PATH.
resolve_self_path() {
    local src="${BASH_SOURCE[0]}"
    if command -v realpath &>/dev/null; then
        realpath "${src}"
    elif readlink -f "${src}" &>/dev/null; then
        readlink -f "${src}"
    else
        local dir
        dir="$(cd "$(dirname "${src}")" && pwd)"
        printf '%s/%s\n' "${dir}" "$(basename "${src}")"
    fi
}
SELF_PATH="$(resolve_self_path)"

# Runtime commands only read the user's configuration.
# Symlink-resolved $HOME. tmux's pane_current_path is already resolved,
# so comparing against a non-canonical $HOME would miss the "~" substitution.
HOME_REAL="$(cd "${HOME}" 2>/dev/null && pwd -P || printf '%s' "${HOME}")"

# --- Helpers ---

die() {
    echo "error: $*" >&2
    exit 1
}
# `|| true`: pty can vanish mid-script (e.g. cmd_stop killing the inner
# server). Under set -e an unguarded echo failure would abort here.
warn() { echo "warning: $*" >&2 || true; }
info() { echo "multmux: $*" || true; }

load_config() {
    [[ -f "${CONF_FILE}" ]] || die "Config not found: ${CONF_FILE}"
    # shellcheck disable=SC1090
    source "${CONF_FILE}"

    local required_vars=(START_DIR MAIN_PANE_WIDTH OVERFLOW_PANES INNER_SESSIONS BASE_CONF OUTER_CONF INNER_CONF SESSION_NAME_COMPONENT_MAX SESSION_NAME_TOTAL_MAX)
    local var missing_vars=()
    for var in "${required_vars[@]}"; do
        [[ -n "${!var+x}" ]] || missing_vars+=("${var}")
    done
    if ((${#missing_vars[@]} > 0)); then
        die "Config ${CONF_FILE} is missing required variable(s): ${missing_vars[*]}. Run 'multmux update' to add settings from the current defaults."
    fi

    if [[ ! "${INNER_SESSIONS}" =~ ^[1-9][0-9]?$ ]]; then
        die "INNER_SESSIONS must be an integer from 1 to 99."
    fi

    # Worst case: one full-size component plus the leading "…/" marker.
    if ((SESSION_NAME_TOTAL_MAX < SESSION_NAME_COMPONENT_MAX + 2)); then
        die "SESSION_NAME_TOTAL_MAX (${SESSION_NAME_TOTAL_MAX}) must be at least SESSION_NAME_COMPONENT_MAX (${SESSION_NAME_COMPONENT_MAX}) + 2."
    fi
}

ensure_cache_dir() {
    mkdir -p "${CACHE_DIR}"
}

write_temp_configs() {
    ensure_cache_dir
    printf '%s\n' "${BASE_CONF}" "${OUTER_CONF}" >"${CACHE_DIR}/outer.conf"
    printf '%s\n' "${BASE_CONF}" "${INNER_CONF}" >"${CACHE_DIR}/inner.conf"

    # Drives CWD-based renaming via tmux's window-renamed hook (automatic-
    # rename is enabled in INNER_CONF). Appended here, not in INNER_CONF,
    # because it needs SELF_PATH baked in. #{session_id} is single-quoted
    # so tmux's own "$0" substitution isn't re-expanded by the shell.
    local dq='"'
    local bsdq='\"'
    local sq="'"
    local hook_path
    hook_path="$(shell_single_quote_escape "${SELF_PATH}")"
    local hook_line
    hook_line="set-hook -g window-renamed ${dq}run-shell ${bsdq}'${hook_path}' _auto-rename ${sq}#{session_id}${sq}${bsdq}${dq}"
    printf '%s\n' "${hook_line}" >>"${CACHE_DIR}/inner.conf"
}

outer_running() {
    ${TMO} list-sessions &>/dev/null 2>&1
}

inner_running() {
    ${TMI} list-sessions &>/dev/null 2>&1
}

inner_session_list() {
    ${TMI} list-sessions -F '#{session_name}' 2>/dev/null | sort
}

current_inner_session() {
    # list-clients only reports genuinely attached clients. Unlike
    # display-message's implicit "current session", it can't fall back
    # to a stale, no-longer-attached session.
    ${TMI} list-clients -F '#{session_name}' 2>/dev/null | head -1
}

validate_session_name() {
    # ':' and '.' are tmux target-spec separators (session:window.pane).
    # tmux allows them in a name but then can't address it via -t.
    local name="$1"

    if [[ "${name}" == "~" ]]; then
        die "Session name cannot be '~' (reserved by tmux for marked pane targets)."
    fi
    if [[ -z "${name}" ]]; then
        die "Session name cannot be empty."
    fi
    if [[ "${name}" == *$'\n'* ]]; then
        die "Session name cannot contain newlines."
    fi
    if [[ "${name}" == *:* ]]; then
        die "Session name cannot contain ':' (reserved by tmux for session:window targets)."
    fi
    if [[ "${name}" == *.* ]]; then
        die "Session name cannot contain '.' (reserved by tmux for window.pane targets)."
    fi
}

# --- CWD-based session naming ---

truncate_component() {
    # Mid-string ellipsis. Result is exactly max characters (ellipsis included).
    local name="$1" max="$2"
    if ((${#name} <= max)); then
        printf '%s' "${name}"
        return
    fi
    local budget=$((max - 1))
    local left=$(((budget + 1) / 2))
    local right=$((budget - left))
    if ((right > 0)); then
        printf '%s…%s' "${name:0:left}" "${name: -right}"
    else
        printf '%s…' "${name:0:left}"
    fi
}

substitute_special_chars() {
    # Same reserved chars as validate_session_name, but auto-rename
    # substitutes instead of rejecting.
    local s="$1"
    s="${s//:/_}"
    s="${s//./_}"
    printf '%s' "${s}"
}

render_path_parts() {
    # Rejoin components, prefixed with "~"/"/" or "…/" once dropped.
    local dropped="$1" leading="$2"
    shift 2
    local joined
    joined="$(
        IFS=/
        echo "$*"
    )"
    if [[ "${dropped}" == true ]]; then
        if [[ -n "${joined}" ]]; then
            printf '…/%s' "${joined}"
        else
            printf '…'
        fi
    elif [[ "${leading}" == "~" ]]; then
        if [[ -n "${joined}" ]]; then
            # shellcheck disable=SC2088  # literal '~' text, not a path to expand
            printf '~/%s' "${joined}"
        else
            # Bare "~" is tmux target syntax for "the marked pane", not
            # addressable as a session name. Use "~/" instead.
            # shellcheck disable=SC2088  # literal '~/' text, not a path to expand
            printf '~/'
        fi
    elif [[ "${leading}" == "/" ]]; then
        printf '/%s' "${joined}"
    else
        printf '%s' "${joined}"
    fi
}

format_session_name() {
    # Pipeline: "~" substitution, per-component truncation, then drop
    # whole components from the left if still too long.
    local raw_path="$1" comp_max="$2" total_max="$3"
    local path="${raw_path}"

    if [[ "${path}" == "${HOME_REAL}" ]]; then
        path="~"
    elif [[ "${path}" == "${HOME_REAL}/"* ]]; then
        path="~${path#"${HOME_REAL}"}"
    fi

    local leading=""
    if [[ "${path}" == "~"* ]]; then
        leading="~"
        path="${path#\~}"
        path="${path#/}"
    elif [[ "${path}" == /* ]]; then
        leading="/"
        path="${path#/}"
    fi

    local -a parts=()
    if [[ -n "${path}" ]]; then
        IFS='/' read -r -a parts <<<"${path}"
    fi

    local i
    for i in "${!parts[@]}"; do
        parts[i]="$(substitute_special_chars "${parts[i]}")"
        parts[i]="$(truncate_component "${parts[i]}" "${comp_max}")"
    done

    local dropped=false
    local result
    result="$(render_path_parts "${dropped}" "${leading}" "${parts[@]:-}")"
    while ((${#result} > total_max)) && ((${#parts[@]} > 1)); do
        parts=("${parts[@]:1}")
        dropped=true
        result="$(render_path_parts "${dropped}" "${leading}" "${parts[@]}")"
    done

    printf '%s' "${result}"
}

canonical_path() {
    # Resolves symlinks like the OS resolves a cwd, so names computed
    # up front match tmux's later pane_current_path. Falls back to the
    # input if the path doesn't exist yet.
    local p="$1"
    (cd "${p}" 2>/dev/null && pwd -P) || printf '%s' "${p}"
}

session_name_for_path() {
    format_session_name "$(canonical_path "$1")" "${SESSION_NAME_COMPONENT_MAX}" "${SESSION_NAME_TOTAL_MAX}"
}

name_in_use() {
    local name="$1" used_list="$2" exclude="$3"
    [[ -n "${exclude}" && "${name}" == "${exclude}" ]] && return 1
    grep -qFx -- "${name}" <<<"${used_list}"
}

unique_session_name() {
    # Lowest available "-N" suffix. $3, if given, is the session's own
    # current name, excluded so renaming to itself isn't a collision.
    local candidate="$1" used_list="$2" exclude="${3:-}"
    if ! name_in_use "${candidate}" "${used_list}" "${exclude}"; then
        printf '%s\n' "${candidate}"
        return
    fi
    local n=1
    while name_in_use "${candidate}-${n}" "${used_list}" "${exclude}"; do
        n=$((n + 1))
    done
    printf '%s-%s\n' "${candidate}" "${n}"
}

# Create an inner session named uniquely relative to base name $1,
# starting in directory $2. Retries once against a fresh session list
# if a concurrent multmux invocation just claimed the first choice.
# Echoes the name used.
create_unique_session() {
    local base="$1" dir="$2" name
    name="$(unique_session_name "${base}" "$(inner_session_list)")"
    if ! ${TMI} new-session -s "${name}" -c "${dir}" -d 2>/dev/null; then
        name="$(unique_session_name "${base}" "$(inner_session_list)")"
        # set -e doesn't propagate into this function's $(...) caller
        # (command substitution subshells don't inherit errexit), so a
        # second failure must be handled explicitly, not left to abort.
        ${TMI} new-session -s "${name}" -c "${dir}" -d || die "Could not create inner session '${name}'."
    fi
    printf '%s\n' "${name}"
}

# Escape $1 for embedding inside a single-quoted shell argument (the
# standard '\'' trick), so a literal quote in a session name can't break
# out of the quoting in the send-keys command built by cmd_start.
shell_single_quote_escape() {
    printf '%s' "${1//\'/\'\\\'\'}"
}

# --- Subcommands ---

cmd_start() {
    local no_attach=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --no-attach)
            no_attach=true
            shift
            ;;
        *) die "Unknown option: $1" ;;
        esac
    done

    if outer_running && inner_running; then
        info "Already running."
        if [[ "${no_attach}" == false ]]; then
            exec ${TMO} attach
        fi
        return 0
    fi

    if outer_running; then
        warn "Found an outer session without inner sessions. Restarting..."
        ${TMO} kill-server 2>/dev/null || true
    fi

    if [[ -n "${TMUX:-}" ]]; then
        die "Cannot start from inside a tmux session. Run from a bare terminal."
    fi

    if inner_running; then
        warn "Found orphaned inner sessions from a previous run. Cleaning up..."
        ${TMI} kill-server 2>/dev/null || true
    fi

    load_config
    write_temp_configs

    # -f loads outer.conf before the first pane exists, instead of tmux's
    # normal config lookup, keeping multmux self-contained. Matters for
    # default-terminal specifically, which only affects panes created
    # after it's set.
    info "Starting outer session..."
    ${TMO} -f "${CACHE_DIR}/outer.conf" new-session -c "${START_DIR}" -d

    # All start in START_DIR and collide on the base name, so suffixes
    # are assigned up front. batch_names[0] is the one attached below.
    local base_name
    base_name="$(session_name_for_path "${START_DIR}")"
    local -a batch_names=("${base_name}")
    local k
    for ((k = 1; k < INNER_SESSIONS; k++)); do
        batch_names+=("${base_name}-${k}")
    done

    # Created directly here, not via send-keys into the outer pane: the
    # outer shell can still be starting up right after new-session
    # returns, and keystrokes sent too early get silently dropped
    # (used to cause fewer than INNER_SESSIONS sessions). -f is a
    # harmless no-op after the first session on an already-running server.
    # Created in batch_names order (index 0 first) so session_id/creation
    # order matches slot order: batch_names[0] is both the lowest-numbered
    # session and the one attached below, so an index/creation-sorted
    # 'choose-tree' (see BASE_CONF) lists it first, not last.
    info "Starting ${INNER_SESSIONS} inner sessions..."
    local idx
    for ((idx = 0; idx < INNER_SESSIONS; idx++)); do
        ${TMI} -f "${CACHE_DIR}/inner.conf" new-session -s "${batch_names[idx]}" -c "${START_DIR}" -d
    done

    # Unset TMUX so the inner attach below isn't treated as nested.
    ${TMO} send-keys "unset TMUX" C-m

    # Escaped for embedding in the single-quoted -t argument below: a
    # literal quote in the name would otherwise break the quoting and
    # leave the outer pane sitting at an unterminated shell command.
    local attach_name
    attach_name="$(shell_single_quote_escape "${batch_names[0]}")"
    info "Attaching to inner ${batch_names[0]}..."
    ${TMO} send-keys "${TMI} attach -t '${attach_name}'" C-m

    for _ in $(seq 1 "${OVERFLOW_PANES}"); do
        ${TMO} split-window -c "${START_DIR}"
    done

    ${TMO} set-window-option main-pane-width "${MAIN_PANE_WIDTH}"
    ${TMO} select-layout main-vertical
    ${TMO} set-hook -g window-resized 'select-layout main-vertical'

    ${TMO} select-pane -t 0

    info "Ready."

    if [[ "${no_attach}" == false ]]; then
        exec ${TMO} attach
    fi
}

cmd_reset_layout() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    info "Resetting outer layout..."
    ${TMO} set-window-option main-pane-width "${MAIN_PANE_WIDTH}"
    ${TMO} select-layout main-vertical
    info "Done."
}

cmd_attach() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    if [[ -n "${TMUX:-}" ]]; then
        info "Already attached."
        return 0
    fi

    exec ${TMO} attach
}

cmd_detach() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    local detached=false
    local clients

    # Only the outer socket is detached. The inner-socket client is the
    # nested "tmux attach" in the outer session's main pane. Detaching it
    # would kill that process instead of just the user's terminal.
    if outer_running; then
        clients=$(${TMO} list-clients -F '#{client_name}' 2>/dev/null || true)
        if [[ -n "${clients}" ]]; then
            while IFS= read -r client; do
                ${TMO} detach-client -t "${client}" 2>/dev/null || true
            done <<<"${clients}"
            detached=true
        fi
    fi

    if [[ "${detached}" == true ]]; then
        info "Detached."
    else
        info "Not attached."
    fi
}

cmd_stop() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running && ! inner_running; then
        info "Not running."
        return 0
    fi

    # || confirm="": non-interactive stdin (EOF) makes 'read' fail; under
    # set -e that would otherwise abort the whole script with no message.
    read -r -p "Kill all multmux sessions? [y/N] " confirm || confirm=""
    if [[ "${confirm}" != [yY] ]]; then
        info "Aborted."
        return 0
    fi

    # Ignore SIGHUP: killing either server below can close this very
    # process's controlling pty, and bash's default reaction to SIGHUP
    # would kill this script before the rest of the kill sequence runs.
    trap '' HUP

    info "Killing inner sessions..."
    ${TMI} kill-server 2>/dev/null || true
    info "Killing outer session..."
    ${TMO} kill-server 2>/dev/null || true
    info "Stopped."
}

cmd_add() {
    if [[ $# -gt 1 ]]; then
        die "Usage: multmux add [path]"
    fi

    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    local target_dir="${1:-${START_DIR}}"
    if [[ $# -eq 1 ]]; then
        [[ -d "${target_dir}" ]] || die "Directory not found: ${target_dir}"
    fi

    local base name
    base="$(session_name_for_path "${target_dir}")"
    name="$(create_unique_session "${base}" "${target_dir}")"

    info "Creating ${name}..."
    ${TMI} source-file "${CACHE_DIR}/inner.conf"

    ${TMI} switch-client -t "${name}"
    info "Switched to ${name}."
}

cmd_remove() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    local current
    current=$(current_inner_session)

    if [[ -z "${current}" ]]; then
        die "Cannot determine current inner session."
    fi

    local sessions
    sessions=$(inner_session_list)
    local count
    count=$(wc -l <<<"${sessions}" | tr -d ' ')

    if [[ "${count}" -le 1 ]]; then
        info "Last session. Creating a replacement..."
        # No exclude=current here: the replacement briefly coexists with
        # the not-yet-killed current session, so reusing its name would
        # be a real tmux "duplicate session" collision, not just logical.
        local base name
        base="$(session_name_for_path "${START_DIR}")"
        name="$(create_unique_session "${base}" "${START_DIR}")"
        ${TMI} source-file "${CACHE_DIR}/inner.conf"
        ${TMI} switch-client -t "${name}"
        ${TMI} kill-session -t "${current}"
        info "Removed ${current}, switched to ${name}."
        return 0
    fi

    # Find previous or next session
    local target=""
    local prev=""
    while IFS= read -r sess; do
        if [[ "${sess}" == "${current}" ]]; then
            if [[ -n "${prev}" ]]; then
                target="${prev}"
                break
            fi
        else
            if [[ -n "${prev}" && "${prev}" == "${current}" ]]; then
                target="${sess}"
                break
            fi
        fi
        prev="${sess}"
    done <<<"${sessions}"

    if [[ -z "${target}" ]]; then
        # Fallback: pick any session that isn't current
        target=$(echo "${sessions}" | grep -vFx -- "${current}" | head -1)
    fi

    ${TMI} switch-client -t "${target}"
    ${TMI} kill-session -t "${current}"
    info "Removed ${current}, switched to ${target}."
}

cmd_rename() {
    if [[ $# -ne 1 ]]; then
        die "Usage: multmux rename <new-name>"
    fi
    local new_name="$1"
    validate_session_name "${new_name}"

    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    local current
    current=$(current_inner_session)

    if [[ -z "${current}" ]]; then
        die "Cannot determine current inner session."
    fi

    if [[ "${new_name}" == "${current}" ]]; then
        info "Session is already named '${new_name}'."
        return 0
    fi

    if inner_session_list | grep -qFx -- "${new_name}"; then
        die "A session named '${new_name}' already exists."
    fi

    ${TMI} rename-session -t "${current}" "${new_name}"
    # Marks it manually renamed so the CWD auto-rename hook skips it.
    ${TMI} set-option -t "${new_name}" @multmux_renamed 1
    info "Renamed ${current} to ${new_name}."
}

cmd_status() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if outer_running; then
        echo "Outer: running (socket: ${OUTER_SOCKET})"
    else
        echo "Outer: not running"
    fi

    if inner_running; then
        echo "Inner: running (socket: ${INNER_SOCKET})"
        local current
        current=$(current_inner_session 2>/dev/null || echo "")
        while IFS= read -r sess; do
            if [[ "${sess}" == "${current}" ]]; then
                echo "  * ${sess} (active)"
            else
                echo "    ${sess}"
            fi
        done <<<"$(inner_session_list)"
    else
        echo "Inner: not running"
    fi
}

# Internal: invoked only by the window-renamed hook (write_temp_configs).
cmd_auto_rename() {
    local session_id="$1"

    if ! inner_running; then
        return 0
    fi

    load_config

    # A manually renamed session stops tracking its CWD.
    local sticky
    sticky=$(${TMI} show-options -v -t "${session_id}" '@multmux_renamed' 2>/dev/null || echo "")
    [[ "${sticky}" == "1" ]] && return 0

    local raw_path current_name
    raw_path=$(${TMI} display-message -p -t "${session_id}" '#{pane_current_path}' 2>/dev/null) || return 0
    current_name=$(${TMI} display-message -p -t "${session_id}" '#{session_name}' 2>/dev/null) || return 0
    [[ -z "${raw_path}" || -z "${current_name}" ]] && return 0

    local base final
    base="$(session_name_for_path "${raw_path}")"
    final="$(unique_session_name "${base}" "$(inner_session_list)" "${current_name}")"

    if [[ "${final}" != "${current_name}" ]]; then
        ${TMI} rename-session -t "${session_id}" "${final}" 2>/dev/null || true
    fi
}

# --- Auto-update check ---
#
# Runs unconditionally from cmd_start every AUTO_UPDATE_CHECK_INTERVAL_DAYS.
# AUTO_UPDATE only controls what happens once a newer version is found:
# install it, or just leave a notice. Never blocks, never fails loudly.

# Is $1 strictly greater than $2? Boolean predicate, must be called from
# if/while/&&/|| (a bare call aborts the script under set -e when false).
version_gt() {
    if [[ "$1" == "$2" ]]; then
        return 1
    fi
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

# Print the latest VERSION, or nothing on any failure. $1 is the
# curl/wget timeout in seconds. Matches with bash regex, not grep/cut:
# a downstream reader exiting early would SIGPIPE curl and, with
# pipefail, abort the script.
fetch_latest_version() {
    local timeout="${1:-3}" content=""
    if command -v curl &>/dev/null; then
        content="$(curl -fsSL --max-time "${timeout}" "${REPO_URL}/multmux" 2>/dev/null)" || true
    elif command -v wget &>/dev/null; then
        content="$(wget -qO- --timeout="${timeout}" "${REPO_URL}/multmux" 2>/dev/null)" || true
    fi
    if [[ "${content}" =~ VERSION=\"([0-9]+\.[0-9]+\.[0-9]+)\" ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
    return 0
}

# Fetch and install the latest multmux, shared by 'update' and auto-update.
perform_update() {
    info "Fetching install script from ${REPO_URL}..."
    if command -v curl &>/dev/null; then
        curl -fsSL "${REPO_URL}/install.sh" | bash
    elif command -v wget &>/dev/null; then
        wget -qO- "${REPO_URL}/install.sh" | bash
    else
        die "Neither curl nor wget found."
    fi
}

# Print a one-line notice if a check found something to report.
# Safe to call even if no check has ever run.
show_update_notice_if_cached() {
    if [[ -f "${CACHE_DIR}/just_auto_updated" ]]; then
        rm -f "${CACHE_DIR}/just_auto_updated"
        info "multmux was automatically updated to v${VERSION}."
        return 0
    fi
    [[ -f "${CACHE_DIR}/latest_version" ]] || return 0
    local latest
    latest="$(cat "${CACHE_DIR}/latest_version" 2>/dev/null)" || return 0
    [[ -n "${latest}" ]] || return 0
    if version_gt "${latest}" "${VERSION}"; then
        info "A newer multmux is available: v${latest} (you have v${VERSION}). Run 'multmux update' to install it."
    fi
    return 0
}

# Read AUTO_UPDATE* independently of load_config, so a broken config
# can't break starting/attaching. Falls back to defaults otherwise.
read_update_settings() {
    AUTO_UPDATE=true
    AUTO_UPDATE_CHECK_INTERVAL_DAYS=7
    [[ -f "${CONF_FILE}" ]] || return 0
    local vals
    vals="$(
        # shellcheck disable=SC1090
        source "${CONF_FILE}" &>/dev/null
        printf '%s\n%s\n' "${AUTO_UPDATE}" "${AUTO_UPDATE_CHECK_INTERVAL_DAYS}"
    )" 2>/dev/null || return 0
    [[ -n "${vals}" ]] || return 0
    AUTO_UPDATE="$(sed -n '1p' <<<"${vals}")"
    AUTO_UPDATE_CHECK_INTERVAL_DAYS="$(sed -n '2p' <<<"${vals}")"
    return 0
}

# Show any pending notice, then check in the background at most once
# every AUTO_UPDATE_CHECK_INTERVAL_DAYS. Never blocks, never fails loudly.
check_for_update() {
    local auto_update interval_days
    read_update_settings
    auto_update="${AUTO_UPDATE}"
    interval_days="${AUTO_UPDATE_CHECK_INTERVAL_DAYS}"

    ensure_cache_dir
    show_update_notice_if_cached

    local now last_check interval_secs
    now=$(date +%s)
    last_check=0
    [[ -f "${CACHE_DIR}/last_update_check" ]] && last_check="$(cat "${CACHE_DIR}/last_update_check" 2>/dev/null || echo 0)"
    [[ "${last_check}" =~ ^[0-9]+$ ]] || last_check=0
    interval_secs=$((interval_days * 86400))
    ((now - last_check < interval_secs)) && return 0

    # Recorded up front so rapid repeated invocations don't all check at once.
    echo "${now}" >"${CACHE_DIR}/last_update_check"

    (
        latest="$(fetch_latest_version 3)"
        if [[ -n "${latest}" ]] && version_gt "${latest}" "${VERSION}"; then
            if [[ "${auto_update}" == true ]]; then
                if perform_update &>/dev/null; then
                    touch "${CACHE_DIR}/just_auto_updated"
                fi
            else
                echo "${latest}" >"${CACHE_DIR}/latest_version"
            fi
        fi
    ) &>/dev/null &
    disown
    return 0
}

# Internal: the public command names, one per line. Both completion
# scripts (completions/multmux.bash, completions/multmux.zsh) call
# 'multmux _commands' to get this list, so they can't drift out of sync
# with the dispatch case below.
cmd_commands() {
    printf '%s\n' start stop attach detach add remove rename status reset-layout update uninstall help version
}

# Fetch the latest version, report whether it's newer, and cache the
# result like the background check does. Used by --dry-run and update.
report_latest_version() {
    ensure_cache_dir
    info "Checking for updates..."
    local latest
    latest="$(fetch_latest_version 5)"
    [[ -n "${latest}" ]] || die "Could not check for updates (network unavailable?)."

    date +%s >"${CACHE_DIR}/last_update_check"

    if version_gt "${latest}" "${VERSION}"; then
        echo "${latest}" >"${CACHE_DIR}/latest_version"
        info "A newer multmux is available: v${latest} (you have v${VERSION}). Run 'multmux update' to install it."
    else
        rm -f "${CACHE_DIR}/latest_version"
        info "multmux is up to date (v${VERSION})."
    fi
}

cmd_update() {
    local dry_run=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --dry-run)
            dry_run=true
            shift
            ;;
        *) die "Unknown option: $1" ;;
        esac
    done

    # A dry run only reports. It never installs.
    if [[ "${dry_run}" == true ]]; then
        report_latest_version
        return 0
    fi

    perform_update
}

cmd_uninstall() {
    local remove_config=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --config)
            remove_config=true
            shift
            ;;
        *) die "Unknown option: $1" ;;
        esac
    done

    local prompt="Uninstall multmux files"
    [[ "${remove_config}" == true ]] && prompt+=" and configuration"
    read -r -p "${prompt}? [y/N] " confirm || confirm=""
    if [[ "${confirm}" != [yY] ]]; then
        info "Aborted."
        return 0
    fi

    rm -f "${INSTALL_DIR}/multmux" \
        "${HOME}/.local/share/bash-completion/completions/multmux" \
        "${HOME}/.local/share/zsh/site-functions/_multmux"
    rm -rf "${CACHE_DIR}"
    [[ "${remove_config}" == true ]] && rm -f "${CONF_FILE}"

    info "Uninstalled. Reinstall with:"
    echo "${REINSTALL_COMMAND}"
}

cmd_help() {
    cat <<EOF
multmux ${VERSION} - tmux session multiplexer

Usage: multmux <command> [options]

Commands:
  start [--no-attach]   Start multmux (idempotent)
  stop                  Stop multmux sessions (asks for confirmation)
  attach                Attach to the outer session (idempotent)
  detach                Detach from multmux, from anywhere (idempotent)
  add [path]            Add a new inner session (default: START_DIR) and switch to it
  remove                Remove the current inner session
  rename <name>         Rename the current inner session
  status                Show outer/inner running state and inner sessions
  reset-layout          Reset outer pane geometry to configured sizes
  update [--dry-run]    Update multmux to the latest version
  uninstall [--config]  Remove multmux files (asks for confirmation)
  help                  Show this help

Configuration: ${CONF_FILE}
EOF
}

# --- Main dispatch ---

# Guarded so tests can `source` this file without running the CLI below.
# ${0} == ${BASH_SOURCE[0]} only when executed directly, not sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    [[ "${1:-help}" == uninstall ]] || command -v tmux &>/dev/null || die "tmux is not installed."
    case "${1:-help}" in
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        shift
        cmd_stop "$@"
        ;;
    attach)
        shift
        cmd_attach "$@"
        ;;
    detach)
        shift
        cmd_detach "$@"
        ;;
    add)
        shift
        cmd_add "$@"
        ;;
    remove)
        shift
        cmd_remove "$@"
        ;;
    rename)
        shift
        cmd_rename "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    _auto-rename)
        shift
        cmd_auto_rename "$@"
        ;;
    _commands) cmd_commands ;;
    reset-layout)
        shift
        cmd_reset_layout "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    uninstall)
        shift
        cmd_uninstall "$@"
        ;;
    help | --help | -h) cmd_help ;;
    version | --version | -v) echo "multmux ${VERSION}" ;;
    *) die "Unknown command: $1. Run 'multmux help' for usage." ;;
    esac
fi
