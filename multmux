set -euo pipefail

# multmux - tmux wrapper using two isolated sockets
# https://github.com/DenisDupeyron/multmux

VERSION="0.2.4"
CONF_FILE="${HOME}/.config/multmux.conf"
CACHE_DIR="${HOME}/.cache/multmux"
OUTER_SOCKET="${MULTMUX_OUTER_SOCKET:-multmux-outer}"
INNER_SOCKET="${MULTMUX_INNER_SOCKET:-multmux-inner}"
TMO="tmux -L ${OUTER_SOCKET}"
TMI="tmux -L ${INNER_SOCKET}"
REPO_URL="https://raw.githubusercontent.com/DenisDupeyron/multmux/main"

# --- Helpers ---

die() {
    echo "error: $*" >&2
    exit 1
}
warn() { echo "warning: $*" >&2; }
info() { echo "multmux: $*"; }

load_config() {
    [[ -f "${CONF_FILE}" ]] || die "Config not found: ${CONF_FILE}"
    # shellcheck disable=SC1090
    source "${CONF_FILE}"

    local required_vars=(START_DIR MAIN_PANE_WIDTH OVERFLOW_PANES INNER_SESSIONS BASE_CONF OUTER_CONF INNER_CONF)
    local var
    for var in "${required_vars[@]}"; do
        [[ -n "${!var+x}" ]] || die "Config ${CONF_FILE} is missing required variable: ${var}"
    done
}

ensure_cache_dir() {
    mkdir -p "${CACHE_DIR}"
}

write_temp_configs() {
    ensure_cache_dir
    printf '%s\n' "${BASE_CONF}" "${OUTER_CONF}" >"${CACHE_DIR}/outer.conf"
    printf '%s\n' "${BASE_CONF}" "${INNER_CONF}" >"${CACHE_DIR}/inner.conf"
}

outer_running() {
    ${TMO} list-sessions &>/dev/null 2>&1
}

inner_running() {
    ${TMI} list-sessions &>/dev/null 2>&1
}

inner_session_count() {
    ${TMI} list-sessions 2>/dev/null | wc -l | tr -d ' '
}

inner_session_list() {
    ${TMI} list-sessions -F '#{session_name}' 2>/dev/null | sort
}

next_session_number() {
    # Find the smallest positive integer not already used by an inner
    # session, so removed sessions' numbers get reused before growing past
    # the current highest number.
    local -A used
    local num
    while IFS= read -r num; do
        [[ -n "${num}" ]] && used["$((10#${num}))"]=1
    done < <(inner_session_list | grep -oE '[0-9]+$')
    local candidate=1
    while [[ -n "${used[${candidate}]+x}" ]]; do
        candidate=$((candidate + 1))
    done
    printf "%02d" "${candidate}"
}

current_inner_session() {
    # The inner client in the main pane. Ask the inner server for its current session
    ${TMI} display-message -p '#{session_name}' 2>/dev/null
}

validate_session_name() {
    # tmux uses ':' to separate session from window, and '.' to separate
    # window from pane, in target specifiers (e.g. session:window.pane).
    # A session name containing either breaks '-t <name>' addressing later,
    # even though tmux happily creates/renames a session with such a name.
    local name="$1"

    if [[ -z "${name}" ]]; then
        die "Session name cannot be empty."
    fi
    if [[ "${name}" == *$'\n'* ]]; then
        die "Session name cannot contain newlines."
    fi
    if [[ "${name}" == *:* ]]; then
        die "Session name cannot contain ':' (reserved by tmux for session:window targets)."
    fi
    if [[ "${name}" == *.* ]]; then
        die "Session name cannot contain '.' (reserved by tmux for window.pane targets)."
    fi
}

# --- Subcommands ---

cmd_start() {
    local no_attach=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --no-attach)
            no_attach=true
            shift
            ;;
        *) die "Unknown option: $1" ;;
        esac
    done

    if outer_running; then
        info "Already running."
        if [[ "${no_attach}" == false ]]; then
            exec ${TMO} attach
        fi
        return 0
    fi

    # Prevent starting from inside a tmux session
    if [[ -n "${TMUX:-}" ]]; then
        die "Cannot start from inside a tmux session. Run from a bare terminal."
    fi

    if inner_running; then
        warn "Found orphaned inner sessions from a previous run. Cleaning up..."
        ${TMI} kill-server 2>/dev/null || true
    fi

    load_config
    write_temp_configs

    info "Starting outer session..."
    ${TMO} new-session -c "${START_DIR}" -d

    info "Loading outer config..."
    ${TMO} source-file "${CACHE_DIR}/outer.conf"

    # Unset TMUX in the main pane so inner sessions can start
    ${TMO} send-keys "unset TMUX" C-m

    info "Starting ${INNER_SESSIONS} inner sessions..."
    for session in $(seq -f "%02g" "${INNER_SESSIONS}" -1 1); do
        ${TMO} send-keys "${TMI} new-session -s session-${session} -c '${START_DIR}' -d" C-m
    done

    # Small delay for sessions to initialize
    sleep 1

    info "Loading inner config..."
    ${TMO} send-keys "${TMI} source-file '${CACHE_DIR}/inner.conf'" C-m

    info "Attaching to inner session-01..."
    ${TMO} send-keys "${TMI} attach -t session-01" C-m

    # Create overflow panes on the right
    for _ in $(seq 1 "${OVERFLOW_PANES}"); do
        ${TMO} split-window -c "${START_DIR}"
    done

    # Set layout
    ${TMO} set-window-option main-pane-width "${MAIN_PANE_WIDTH}"
    ${TMO} select-layout main-vertical
    ${TMO} set-hook -g window-resized 'select-layout main-vertical'

    # Focus the main pane
    ${TMO} select-pane -t 0

    info "Ready."

    if [[ "${no_attach}" == false ]]; then
        exec ${TMO} attach
    fi
}

cmd_reset_layout() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    info "Resetting outer layout..."
    ${TMO} set-window-option main-pane-width "${MAIN_PANE_WIDTH}"
    ${TMO} select-layout main-vertical
    info "Done."
}

cmd_attach() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    if [[ -n "${TMUX:-}" ]]; then
        info "Already attached."
        return 0
    fi

    exec ${TMO} attach
}

cmd_detach() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    local detached=false
    local clients

    # Only detach clients on the outer socket. In normal use, the only
    # inner-socket client is the nested "tmux attach" running inside the
    # outer session's main pane (pane 0), and detaching it there would kill
    # that nested process, leaving pane 0 on a bare shell instead of the
    # inner session view on the next attach. Detaching the user's real
    # terminal from the outer socket, from any pane or session, is enough
    # to return them to a plain, non-multiplexed terminal.

    if outer_running; then
        clients=$(${TMO} list-clients -F '#{client_name}' 2>/dev/null || true)
        if [[ -n "${clients}" ]]; then
            while IFS= read -r client; do
                ${TMO} detach-client -t "${client}" 2>/dev/null || true
            done <<<"${clients}"
            detached=true
        fi
    fi

    if [[ "${detached}" == true ]]; then
        info "Detached."
    else
        info "Not attached."
    fi
}

cmd_stop() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    if ! outer_running && ! inner_running; then
        info "Not running."
        return 0
    fi

    read -r -p "Kill all multmux sessions? [y/N] " confirm
    if [[ "${confirm}" != [yY] ]]; then
        info "Aborted."
        return 0
    fi

    info "Killing inner sessions..."
    ${TMI} kill-server 2>/dev/null || true
    info "Killing outer session..."
    ${TMO} kill-server 2>/dev/null || true
    info "Stopped."
}

cmd_add() {
    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    local num
    num=$(next_session_number)
    local name="session-${num}"

    info "Creating ${name}..."
    ${TMI} new-session -s "${name}" -c "${START_DIR}" -d
    ${TMI} source-file "${CACHE_DIR}/inner.conf"

    # Switch the inner client to the new session
    ${TMI} switch-client -t "${name}"
    info "Switched to ${name}."
}

cmd_remove() {
    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    load_config

    local current
    current=$(current_inner_session)

    if [[ -z "${current}" ]]; then
        die "Cannot determine current inner session."
    fi

    local sessions
    sessions=$(inner_session_list)
    local count
    count=$(echo "${sessions}" | wc -l | tr -d ' ')

    if [[ "${count}" -le 1 ]]; then
        # Last session. Kill it and create a fresh one
        info "Last session. Creating a replacement..."
        local num
        num=$(next_session_number)
        local name="session-${num}"
        ${TMI} new-session -s "${name}" -c "${START_DIR}" -d
        ${TMI} source-file "${CACHE_DIR}/inner.conf"
        ${TMI} switch-client -t "${name}"
        ${TMI} kill-session -t "${current}"
        info "Removed ${current}, switched to ${name}."
        return 0
    fi

    # Find previous or next session
    local target=""
    local prev=""
    while IFS= read -r sess; do
        if [[ "${sess}" == "${current}" ]]; then
            if [[ -n "${prev}" ]]; then
                target="${prev}"
                break
            fi
        else
            if [[ -n "${prev}" && "${prev}" == "${current}" ]]; then
                target="${sess}"
                break
            fi
        fi
        prev="${sess}"
    done <<<"${sessions}"

    if [[ -z "${target}" ]]; then
        # Fallback: pick any session that isn't current
        target=$(echo "${sessions}" | grep -v "^${current}$" | head -1)
    fi

    ${TMI} switch-client -t "${target}"
    ${TMI} kill-session -t "${current}"
    info "Removed ${current}, switched to ${target}."
}

cmd_rename() {
    if [[ $# -ne 1 ]]; then
        die "Usage: multmux rename <new-name>"
    fi
    local new_name="$1"
    validate_session_name "${new_name}"

    if ! inner_running; then
        die "multmux is not running. Use 'multmux start' first."
    fi

    local current
    current=$(current_inner_session)

    if [[ -z "${current}" ]]; then
        die "Cannot determine current inner session."
    fi

    if [[ "${new_name}" == "${current}" ]]; then
        info "Session is already named '${new_name}'."
        return 0
    fi

    if inner_session_list | grep -qx "${new_name}"; then
        die "A session named '${new_name}' already exists."
    fi

    ${TMI} rename-session -t "${current}" "${new_name}"
    info "Renamed ${current} to ${new_name}."
}

cmd_list() {
    if ! inner_running; then
        die "multmux is not running."
    fi

    local current
    current=$(current_inner_session 2>/dev/null || echo "")

    echo "Inner sessions (socket: ${INNER_SOCKET}):"
    while IFS= read -r sess; do
        if [[ "${sess}" == "${current}" ]]; then
            echo "  * ${sess} (active)"
        else
            echo "    ${sess}"
        fi
    done <<<"$(inner_session_list)"
}

cmd_update() {
    if [[ $# -gt 0 ]]; then
        die "Unknown option: $1"
    fi

    info "Fetching install script from ${REPO_URL}..."
    if command -v curl &>/dev/null; then
        curl -fsSL "${REPO_URL}/install.sh" | bash
    elif command -v wget &>/dev/null; then
        wget -qO- "${REPO_URL}/install.sh" | bash
    else
        die "Neither curl nor wget found."
    fi
}

cmd_help() {
    cat <<EOF
multmux ${VERSION} - tmux session multiplexer

Usage: multmux <command> [options]

Commands:
  start [--no-attach]   Start multmux (idempotent)
  stop                  Stop multmux sessions (asks for confirmation)
  attach                Attach to the outer session (idempotent)
  detach                Detach from multmux, from anywhere (idempotent)
  add                   Add a new inner session and switch to it
  remove                Remove the current inner session
  rename <name>         Rename the current inner session
  list                  List inner sessions
  reset-layout          Reset outer pane geometry to configured sizes
  update                Update multmux to the latest version
  help                  Show this help

Configuration: ${CONF_FILE}
EOF
}

# --- Main dispatch ---

case "${1:-help}" in
start)
    shift
    cmd_start "$@"
    ;;
stop)
    shift
    cmd_stop "$@"
    ;;
attach)
    shift
    cmd_attach "$@"
    ;;
detach)
    shift
    cmd_detach "$@"
    ;;
add)
    shift
    cmd_add "$@"
    ;;
remove)
    shift
    cmd_remove "$@"
    ;;
rename)
    shift
    cmd_rename "$@"
    ;;
list) cmd_list ;;
reset-layout)
    shift
    cmd_reset_layout "$@"
    ;;
update)
    shift
    cmd_update "$@"
    ;;
help | --help | -h) cmd_help ;;
version | --version | -v) echo "multmux ${VERSION}" ;;
*) die "Unknown command: $1. Run 'multmux help' for usage." ;;
esac
